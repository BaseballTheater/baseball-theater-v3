// The API and web app as one Cloudflare Worker (S45; ADR-017). `pnpm dev` runs it on
// the local Workers runtime (workerd) with no Cloudflare login. No account id or
// secrets live here: sessions use BT_SESSION_KEY from `.dev.vars` or a deploy secret.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baseball-theater",
	"main": "functions/src/worker.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	// The built SPA. `/api/*` always reaches the Worker; any other unknown path is the
	// app's index.html, so client routes like /games/2024-07-04 load on refresh.
	"assets": {
		"directory": "web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/health"]
	},
	// Once a minute (the cron floor) the cron ensures one game-ingest:<gamePk> object per
	// in-window game (S48; ADR-020); each object's alarm owns that game's ADR-002 cadence.
	// In local dev it runs only with BT_INGEST_TICK=1.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"durable_objects": {
		// S18: game-hub:<gamePk> holds each game's viewers' WebSockets (ADR-020 layer 2).
		"bindings": [
			{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
			{ "name": "GAME_HUB", "class_name": "GameHubObject" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["GameIngestObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["GameHubObject"] }
	],
	// Workers Cache (S47, ADR-021; owner, 2026-10-30: "Workers cache"): Cloudflare checks
	// its tiered edge cache before running the Worker and keeps schedule and game responses
	// as long as their Cache-Control says. Every request is then billed at the Workers
	// rate, static assets included (ADR-017's cost line).
	"cache": {
		"enabled": true
	},
	// Postgres through Hyperdrive (ADR-018, S50). No deploy uses this top-level binding or any
	// `id` in this file: each deploy finds its env's config by name (`bt-production`, `bt-staging`)
	// and writes the id it resolves into the config it deploys (S114, `pnpm deploy:bootstrap`), so
	// the zeros below are placeholders. Locally, `wrangler dev` and the Workers tests connect to
	// `localConnectionString` instead: a local Postgres (S51's Docker), never a hosted database.
	// No credential for one is committed.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://bt:bt@localhost:5432/bt"
		}
	],
	// The deployed Workers (S113, S114), deployed only by `.github/workflows/deploy.yml`; agents
	// never deploy (CLAUDE.md). Environments don't inherit bindings, so each env restates the
	// Durable Objects, its Hyperdrive binding and its vars, and names its own Worker, apart from the
	// top-level config's local one, so a deploy without `--env` can never replace a deployed one.
	// The Durable Object `migrations` stay top-level. Every deployed env serves live MLB and names
	// its own address as BT_APP_ORIGIN; BT_SESSION_KEY is a Worker secret that every deploy pushes
	// from GitHub secrets (`--secrets-file`), never a var. None sets BT_LOCAL, so none accepts a
	// `dev:` sign-in (S114 AC 7). Sign-in is Logto (S116), offered only where an env's vars name
	// a tenant (LOGTO_ENDPOINT, LOGTO_APP_ID): production's own tenant, never shared with another
	// env. Previews offer no sign-in (owner, 2026-11-07: "Yes", to previews without sign-in), and
	// staging none until its own Logto tenant exists (owner, 2026-11-06: "We will use a staging
	// one or a fake shim"); its vars are then added to env.staging, never production's.
	"env": {
		// One Worker per pull request (`baseball-theater-pr-<N>` on workers.dev, its name and
		// BT_APP_ORIGIN set at deploy time) on staging's database, `bt-staging` (owner, 2026-11-05:
		// "Previews share staging db"). No cron: a preview reads MLB through on request only, so
		// open pull requests don't each poll on ADR-002's cadence.
		"preview": {
			"name": "baseball-theater-preview",
			"workers_dev": true,
			"triggers": {
				"crons": []
			},
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1"
			}
		},
		// Every push to stage, at stage.baseball.theater, on the Neon `staging` branch through
		// `bt-staging`: a schema-only branch that never holds a fan's data (S114 AC 9).
		"staging": {
			"name": "baseball-theater-staging",
			"workers_dev": false,
			"routes": [{ "pattern": "stage.baseball.theater", "custom_domain": true }],
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1",
				"BT_APP_ORIGIN": "https://stage.baseball.theater"
			}
		},
		// Every push to main, at next.baseball.theater until the owner's DNS cutover (S119; owner,
		// 2026-11-07: "Do the temporary address"): baseball.theater still points at the Elastic
		// Beanstalk (v2) site, and a deploy that claimed it would replace that DNS record at once.
		// Cutting over is the owner's step: set this route and BT_APP_ORIGIN to baseball.theater
		// (README). Its Hyperdrive config is `bt-production`, which the owner created on
		// 2026-11-02 for the Neon project `old-sun-72319473` (Postgres 18); its connection string
		// lives only in Cloudflare. Its Logto tenant (S116; the owner's, at the custom domain
		// auth.baseball.theater, tenant ID `rnrngs`) signs fans in through the single-page app
		// LOGTO_APP_ID; the Management API is reached at rnrngs.logto.app (Logto Cloud serves it on no
		// custom domain) by the machine-to-machine app whose ID and secret are Worker secrets.
		// Every production deploy registers the app's sign-in and sign-out addresses from
		// BT_APP_ORIGIN (`pnpm deploy:logto`), so the cutover moves them too.
		"production": {
			"name": "baseball-theater-production",
			"workers_dev": false,
			"routes": [{ "pattern": "next.baseball.theater", "custom_domain": true }],
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"BT_USE_LIVE_MLB": "1",
				"BT_APP_ORIGIN": "https://next.baseball.theater",
				"LOGTO_ENDPOINT": "https://auth.baseball.theater",
				"LOGTO_APP_ID": "1b1sc2uclfqak0swrahef",
				"LOGTO_TENANT_ID": "rnrngs"
			}
		}
	},
	// No anonymous usage telemetry from local runs.
	"send_metrics": false,
	"observability": {
		"enabled": true
	}
}
