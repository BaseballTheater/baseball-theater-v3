// The API and web app as one Cloudflare Worker (S45; ADR-017). `pnpm dev` runs it on
// the local Workers runtime (workerd) with no Cloudflare login. No account id or
// secrets live here: sessions use BT_SESSION_KEY from `.dev.vars` or a deploy secret.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "baseball-theater",
	"main": "functions/src/worker.ts",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	// The built SPA. `/api/*` always reaches the Worker; any other unknown path is the
	// app's index.html, so client routes like /games/2024-07-04 load on refresh.
	"assets": {
		"directory": "web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/health"]
	},
	// Once a minute (the cron floor) the cron ensures one game-ingest:<gamePk> object per
	// in-window game (S48; ADR-020); each object's alarm owns that game's ADR-002 cadence.
	// In local dev it runs only with BT_INGEST_TICK=1.
	"triggers": {
		"crons": ["* * * * *"]
	},
	"durable_objects": {
		// S18: game-hub:<gamePk> holds each game's viewers' WebSockets (ADR-020 layer 2).
		"bindings": [
			{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
			{ "name": "GAME_HUB", "class_name": "GameHubObject" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["GameIngestObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["GameHubObject"] }
	],
	// Workers Cache (S47, ADR-021; owner, 2026-10-30: "Workers cache"): Cloudflare checks
	// its tiered edge cache before running the Worker and keeps schedule and game responses
	// as long as their Cache-Control says. Every request is then billed at the Workers
	// rate, static assets included (ADR-017's cost line).
	"cache": {
		"enabled": true
	},
	// Postgres through Hyperdrive (ADR-018, S50). This top-level `id` is a placeholder that no
	// deploy uses: the production env below names the real config (S113). Locally,
	// `wrangler dev` and the Workers tests connect to `localConnectionString` instead: a local
	// Postgres (S51's Docker), never a hosted database. No credential for one is committed.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgres://bt:bt@localhost:5432/bt"
		}
	],
	// The production Worker (S113). Environments don't inherit bindings, so the env restates the
	// Durable Objects and its own Hyperdrive config: `bt-production`, which the owner created on
	// 2026-11-02 for the Neon project `old-sun-72319473` (Postgres 18). Its connection string lives
	// only in Cloudflare. The env names its Worker on purpose, apart from the top-level config's
	// local one, so a deploy without `--env production` can never replace production. The Durable
	// Object `migrations` stay top-level. S114 adds the routes, vars and secrets and deploys it;
	// agents never deploy to production (CLAUDE.md).
	"env": {
		"production": {
			"name": "baseball-theater-production",
			"durable_objects": {
				"bindings": [
					{ "name": "GAME_INGEST", "class_name": "GameIngestObject" },
					{ "name": "GAME_HUB", "class_name": "GameHubObject" }
				]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "db27b03ce9734c3f928241ce8ee855f6"
				}
			]
		}
	},
	// No anonymous usage telemetry from local runs.
	"send_metrics": false,
	"observability": {
		"enabled": true
	}
}
