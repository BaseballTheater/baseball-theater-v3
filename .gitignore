.backfill/

# IDE / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
ui-debug.log*

# Husky local
.husky/_

# Obsidian workspace/settings for the backlog notes (docs/v3/VAULT-MIGRATION.md V3)
docs/v3/backlog/.obsidian/

# Playwright output (S81); design captures live in docs/v3/design-checks/
e2e/test-results/
e2e/playwright-report/

# Design-match pairs laid out for the owner (pnpm design:review); delete a story's folder after the verdict
.designreview/

# Obsidian window/pane layout for the docs/v3 vault: changes every time the vault is opened
docs/v3/.obsidian/workspace.json
# The Obsidian Bases view of the backlog: Obsidian rewrites it on open; `pnpm backlog:build` seeds a default when it is missing
docs/v3/backlog/Backlog.base
