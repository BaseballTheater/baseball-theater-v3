dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.pem
keys.json
service-account*.json

# Wrangler local state and local Worker vars (S45)
.wrangler/
.dev.vars

