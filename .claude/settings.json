{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./secrets/**)",
			"Edit(./.env)",
			"Edit(./.env.*)",
			"Edit(./secrets/**)",
			"Bash(firebase deploy *)",
			"Bash(firebase functions:delete *)",
			"Bash(wrangler deploy *)",
			"Bash(npx wrangler deploy *)",
			"Bash(pnpm wrangler deploy *)",
			"Bash(wrangler secret *)",
			"Bash(wrangler delete *)",
			"Bash(gcloud *)",
			"Bash(gh secret *)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)",
			"Bash(git clean -fd *)",
			"Bash(gh pr merge *--admin*)",
			"Bash(gh pr create *--base*main*)",
			"Bash(gh pr create *-B*main*)",
			"Bash(gh pr edit *--base*)",
			"Bash(gh pr edit *-B*)"
		],
		"ask": [
			"Bash(git push *)",
			"Bash(neonctl *)",
			"Bash(pnpm publish *)",
			"Bash(npm publish *)"
		],
		"allow": ["Bash(pnpm *)", "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git branch *)"]
	},
	"hooks": {
		"UserPromptSubmit": [
			{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/review-gate.sh prompt" }] }
		],
		"Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/review-gate.sh stop" }] }]
	}
}
