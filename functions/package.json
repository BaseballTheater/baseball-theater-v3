{
	"name": "@bt/functions",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "mkdir -p ../web/dist && wrangler dev --config ../wrangler.jsonc --port 8787 --var BT_LOCAL:1",
		"start": "tsx src/local-server.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run && vitest run --config vitest.workers.config.ts",
		"test:coverage": "vitest run --coverage && vitest run --config vitest.workers.config.ts",
		"record-fixtures": "tsx src/scripts/record-fixtures.ts",
		"capture-replay": "tsx src/scripts/capture-replay.ts",
		"test:workerd": "vitest run --config vitest.workers.config.ts"
	},
	"dependencies": {
		"@bt/domain": "workspace:*",
		"@bt/mlb-api": "workspace:*",
		"@bt/ports": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.12.21",
		"@types/node": "^22.13.10",
		"oasdiff-js": "2.0.4",
		"prettier": "3.9.6",
		"ts-json-schema-generator": "2.9.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8",
		"wrangler": "4.149.0"
	}
}
