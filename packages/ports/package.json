{
	"name": "@bt/ports",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --passWithNoTests --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary --reporter=dot --silent=passed-only"
	},
	"dependencies": {
		"@bt/domain": "workspace:*",
		"@bt/mlb-api": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	}
}
